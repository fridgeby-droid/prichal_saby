# demo: no external Saby/YooKassa requests. integration: real Saby + YooKassa test key.
APP_MODE=catalog
PORT=8000
PUBLIC_URL=http://localhost:8000
DB_PATH=/app/data/pickup.db
STORES_FILE=config/stores.json
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_CHAT_ID=
SABY_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
# Fill from observed productState values on your Saby test order. Do not guess codes.
SABY_STATE_MAP={}
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
ALLOW_REAL_PAYMENTS=false
LIVE_ACCEPTANCE_CONFIRMED=false
RECEIPT_ENABLED=false
RECEIPT_VAT_CODE=
RECEIPT_TAX_SYSTEM=

# Mapping: point ID -> selected price list ID. No fallback to the whole catalog.
SABY_STORE_PRICES={}
SABY_STORE_CHATS={}

# Bothost PostgreSQL connection URL; never commit real credentials.
# If empty, SQLite at DB_PATH is used (local/demo compatibility).
DATABASE_URL=
PHOTO_DIR=/app/data/photos
CATALOG_SYNC_SECONDS=300
CATALOG_MAX_AGE_SECONDS=900
PHOTO_REFRESH_SECONDS=86400
PHOTO_CACHE_MAX_MB=1024
# Authorized store employees for order support, point ID -> Telegram user IDs.
SABY_STORE_STAFF={}
