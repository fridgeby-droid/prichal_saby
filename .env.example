# Причал 0.6.1. В Bothost: имя слева от =, значение справа, без внешних кавычек.
# Шаблон требует заполнения. Не заменяйте рабочие секреты пустыми значениями.
APP_MODE=integration
PORT=8000
PUBLIC_URL=https://ВАШ-БОТ.bothost.tech
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SUPPORT_GROUP_ID=-1004496259606
ADMIN_CHAT_ID=
MAINTENANCE_MODE=false

SABY_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
SABY_STORE_PRICES={"37462":66,"5635":66,"5604":66,"5617":66,"5629":66,"33446":66,"5611":66,"5590":66,"5583":66,"5623":66,"398":66,"5598":66}
SABY_STATE_MAP={"2000":"accepted","2001":"accepted","2002":"collecting","2003":"ready","2005":"ready","2999":"completed"}
CATALOG_SYNC_SECONDS=300
CATALOG_MAX_AGE_SECONDS=900
CATALOG_FEATURED_IDS=[]

PICKUP_LOCAL_SCHEDULE=true
PICKUP_OPEN=19:00
PICKUP_CLOSE=02:00
PICKUP_ASSEMBLY_MINUTES=15
PICKUP_TIMEZONE=Asia/Yekaterinburg
PICKUP_GEO_REQUIRED=true
PICKUP_MINIMUM_RUB=1200
PICKUP_MINIMUM_BY_STORE={}
TEST_AUTO_PICKUP_TIME=false

# До переезда оставьте прежний DATABASE_URL и PHOTO_STORAGE=local.
DATABASE_URL=
# Для Timeweb по домену: verify-full; CA из панели -> Base64.
DATABASE_SSLMODE=
DATABASE_SSL_CA_B64=
DB_PATH=/app/data/pickup.db
PHOTO_DIR=/app/data/photos
PHOTO_STORAGE=local
PHOTO_REFRESH_SECONDS=86400
PHOTO_CACHE_MAX_MB=1024
# Включите PHOTO_STORAGE=s3 после заполнения всех параметров.
# Endpoint и регион проверяйте в панели именно вашего бакета.
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=pickup/photos
# Оставьте пустым для приватного бакета: приложение выдаёт временные ссылки.
S3_PUBLIC_BASE_URL=

# Тестовые платежи: false. Реальные: оба true после проверки настроек.
ALLOW_REAL_PAYMENTS=false
LIVE_ACCEPTANCE_CONFIRMED=false
# Сохраните действующую настройку чеков. Ниже тестовое значение.
RECEIPT_ENABLED=false
RECEIPT_VAT_CODE=
RECEIPT_TAX_SYSTEM=

# Одна общая пара ЮKassa для всех магазинов.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Старые групповые настройки при SUPPORT_GROUP_ID не используются для обращений.
SABY_STORE_CHATS={}
SABY_STORE_STAFF={}
# Необязательно: путь к локальному справочнику (для demo).
STORES_FILE=config/stores.json
